<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Poe2PriceGui</RootNamespace>
    <AssemblyName>Poe2PriceGui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>Poe2PriceGui.App</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      解决 .NET 10/11 SDK 构建 net8.0-windows WPF 项目时的 _wpftmp 重复 AssemblyInfo 错误。
      WPF markup 编译器生成的临时项目(*_wpftmp.csproj)会继承主项目的 AssemblyInfo 生成,
      导致 AssemblyCompanyAttribute / TargetPlatformAttribute 等重复。
      关闭 SDK 默认的 AssemblyInfo 生成,wpftmp 临时项目就不再产生冲突文件。
      同时关闭 TargetFrameworkAttribute 生成,避免 .NETCoreApp 文件重复。
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
    <PackageReference Include="Velopack" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Xiletrade\Xiletrade.Library.csproj" />
  </ItemGroup>

  <!--
    泥人补丁 GGPK 模式的写入逻辑在主项目内（SmootherGgpkBackupStore.cs），
    直接调用 LibBundledGGPK3 + LibBundle3 + LibGGPK3，无需外部工具进程。
  -->

  <!-- BundleExtractor 依赖：直接引用 LibBundle3，替代调用外部 exe -->
  <ItemGroup>
    <Reference Include="LibBundle3">
      <HintPath>libs\bundle\LibBundle3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SystemExtensions">
      <HintPath>libs\bundle\SystemExtensions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="libs\bundle\oo2core.dll">
      <Link>oo2core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- GGPK 写入依赖：直接引用 LibGGPK3 + LibBundledGGPK3，替代调用外部 exe -->
  <!-- 用途：泥人补丁 GGPK 模式把新 _.index.bin 和 TinyPoe2Smoother/0.bundle.bin 写入 Content.ggpk -->
  <ItemGroup>
    <Reference Include="LibGGPK3">
      <HintPath>libs\ggpk\LibGGPK3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LibBundledGGPK3">
      <HintPath>libs\ggpk\LibBundledGGPK3.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Xiletrade 源码由其自身 csproj 编译为类库，不应被主项目重复编译 -->
  <ItemGroup>
    <Compile Remove="Xiletrade\**" />
    <None Remove="Xiletrade\**" />
    <EmbeddedResource Remove="Xiletrade\**" />
    <Page Remove="Xiletrade\**" />
  </ItemGroup>

  <!-- agent/ 目录仅存放方案文档和备份源码，不应参与编译 -->
  <ItemGroup>
    <Compile Remove="agent\**" />
    <None Remove="agent\**" />
    <EmbeddedResource Remove="agent\**" />
    <Page Remove="agent\**" />
  </ItemGroup>

  <!-- test_tools/ 目录是独立的测试/分析工具，含有各自的 Program.cs，不应参与主项目编译 -->
  <ItemGroup>
    <Compile Remove="test_tools\**" />
    <None Remove="test_tools\**" />
    <EmbeddedResource Remove="test_tools\**" />
    <Page Remove="test_tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="scripts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- tools\PatchTools 和 tools\GGPKExtractor 已被内置 LibBundle3/LibBundledGGPK3 代码替代，不再随发布复制 -->
    <None Remove="tools\PatchTools\**" />
    <None Remove="tools\GGPKExtractor\**" />
    <None Update="tools\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- tools\ 下的子项目(oodle_probe, analyze_bundle 等)有自己的 .csproj,
         不应被主项目编译,否则 Program 类会冲突。 -->
    <Compile Remove="tools\**" />
  </ItemGroup>

  <!-- 预构建的翻译表随程序打包发布（开发者通过"生成翻译表"按钮生成后提交到 Git） -->
  <ItemGroup>
    <Content Include="data\translations\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 技能特效补丁/还原包随程序一起复制到输出目录 -->
  <ItemGroup>
    <Content Include="data\patcheffect\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="data\orginpatcheffect\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Velopack: 将 App.xaml 从 ApplicationDefinition 改为 Page，以便使用自定义 Main 方法 -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
