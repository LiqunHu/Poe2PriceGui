<Window x:Class="Poe2PriceGui.Windows.AutoUpdateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动更新设置"
        Width="380"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF4F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="自动更新设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="价格阈值（崇高石 e）：" Margin="0,0,0,5" Foreground="#FF333333"/>
        <TextBox Grid.Row="2" Text="{Binding AutoFilterMinPrice, UpdateSourceTrigger=LostFocus}"
                 VerticalContentAlignment="Center" Padding="8,4" FontSize="14"/>

        <TextBlock Grid.Row="3" Text="说明：价格 ≥ 阈值的通货规则将设为 Show，低于阈值的设为 Hide。仅作用于通货类规则。"
                   Foreground="Gray" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定" Padding="25,6" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="取消" Padding="25,6" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
