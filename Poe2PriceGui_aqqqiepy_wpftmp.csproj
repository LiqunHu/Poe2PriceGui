<Project>
  <PropertyGroup>
    <AssemblyName>Poe2PriceGui</AssemblyName>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>E:\source\POE Tools\poe_tools\src\Poe2PriceGui\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>Poe2PriceGui</_TargetAssemblyProjectName>
    <RootNamespace>Poe2PriceGui</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Poe2PriceGui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>Poe2PriceGui.App</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      解决 .NET 10/11 SDK 构建 net8.0-windows WPF 项目时的 _wpftmp 重复 AssemblyInfo 错误。
      WPF markup 编译器生成的临时项目(*_wpftmp.csproj)会继承主项目的 AssemblyInfo 生成,
      导致 AssemblyCompanyAttribute / TargetPlatformAttribute 等重复。
      关闭 SDK 默认的 AssemblyInfo 生成,wpftmp 临时项目就不再产生冲突文件。
      同时关闭 TargetFrameworkAttribute 生成,避免 .NETCoreApp 文件重复。
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
    <PackageReference Include="Velopack" Version="1.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Xiletrade\Xiletrade.Library.csproj" />
  </ItemGroup>
  <!--
    泥人补丁 GGPK 模式专用工具。
    通过 ProjectReference 让 MSBuild 先编译这个 Exe，再把它的输出
    （exe + 依赖 dll）作为 Content 复制到主项目 output 目录。
    ReferenceOutputAssembly=false 因为主项目不通过 dll 引用它，而是通过 Process.Start 调起。
  -->
  <ItemGroup>
    <ProjectReference Include="test_tools\SmootherPatchBundledGGPK3\SmootherPatchBundledGGPK3.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <SetTargetFramework>TargetFramework=net8.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>
  <!-- BundleExtractor 依赖：直接引用 LibBundle3，替代调用外部 exe -->
  <ItemGroup>
    <None Include="libs\bundle\oo2core.dll">
      <Link>oo2core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- GGPK 写入依赖：直接引用 LibGGPK3 + LibBundledGGPK3，替代调用外部 exe -->
  <!-- 用途：泥人补丁 GGPK 模式把新 _.index.bin 和 TinyPoe2Smoother/0.bundle.bin 写入 Content.ggpk -->
  <ItemGroup>
  </ItemGroup>
  <!-- Xiletrade 源码由其自身 csproj 编译为类库，不应被主项目重复编译 -->
  <ItemGroup>
    <Compile Remove="Xiletrade\**" />
    <None Remove="Xiletrade\**" />
    <EmbeddedResource Remove="Xiletrade\**" />
  </ItemGroup>
  <!-- agent/ 目录仅存放方案文档和备份源码，不应参与编译 -->
  <ItemGroup>
    <Compile Remove="agent\**" />
    <None Remove="agent\**" />
    <EmbeddedResource Remove="agent\**" />
  </ItemGroup>
  <!-- test_tools/ 目录是独立的测试/分析工具，含有各自的 Program.cs，不应参与主项目编译 -->
  <ItemGroup>
    <Compile Remove="test_tools\**" />
    <None Remove="test_tools\**" />
    <EmbeddedResource Remove="test_tools\**" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <None Update="scripts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="tools\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- tools\ 下的子项目(oodle_probe, analyze_bundle 等)有自己的 .csproj,
         不应被主项目编译,否则 Program 类会冲突。 -->
    <Compile Remove="tools\**" />
  </ItemGroup>
  <!-- 预构建的翻译表随程序打包发布（开发者通过"生成翻译表"按钮生成后提交到 Git） -->
  <ItemGroup>
    <Content Include="data\translations\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Velopack: 将 App.xaml 从 ApplicationDefinition 改为 Page，以便使用自定义 Main 方法 -->
